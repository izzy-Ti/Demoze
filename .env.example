# Copy this file to .env and fill in your own values. Never commit .env.

# Neon Postgres connection string (Neon dashboard -> Connect)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Long random secret used to hash device ids and sign tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_SALT="change-me-to-a-long-random-string"

# Password for the /admin moderation area
ADMIN_PASSWORD="change-me-to-a-strong-password"

# Google Gemini API key (https://aistudio.google.com/apikey) used to read payslips
GEMINI_API_KEY="your-gemini-api-key"

# Optional: Gemini model used for payslip reading
GEMINI_MODEL="gemini-2.5-flash"

# Optional: public site URL, used for SEO / Open Graph links
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
